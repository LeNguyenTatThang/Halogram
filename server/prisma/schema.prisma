generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  username              String               @unique @db.VarChar(50)
  displayName           String
  email                 String               @unique @db.VarChar(255)
  password              String               @db.VarChar(255)
  firstName             String
  lastName              String
  avatar                String?
  bio                   String?              @db.Text
  isVerified            Boolean              @default(false)
  refreshToken          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  posts                 Post[]
  comments              Comment[]
  following             Follow[]             @relation("following")
  followers             Follow[]             @relation("followers")
  received              Friendship[]         @relation("FriendOf")
  sentRequests          Friendship[]         @relation("FriendRequests")
  postLikes             PostLike[]
  stories               Story[]
  storyViews            StoryView[]
  conversations         ConversationMember[]
  messages              Message[]
  callsMade             Call[]               @relation("CallerCalls")
  callsReceived         Call[]               @relation("ReceiverCalls")
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsSent     Notification[]       @relation("NotificationActor")
  savedPosts            SavedPost[]
  postTags              PostTag[]
  livestreams           Livestream[]
  livestreamMessages    LivestreamMessage[]
  shop                  Shop?
  cart                  Cart?
  orders                Order[]
  voucherUsages         VoucherUsage[]

  @@map("users")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Story {
  id         String      @id @default(cuid())
  image      String
  userId     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyViews StoryView[]

  @@index([userId])
  @@map("stories")
}

model Post {
  id            String         @id @default(cuid())
  caption       String?        @db.Text
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  images        PostImage[]
  likes         PostLike[]
  notifications Notification[]
  savedBy       SavedPost[]
  tags          PostTag[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("posts")
}

model PostImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

model Comment {
  id            String         @id @default(cuid())
  text          String         @db.Text
  postId        String
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model StoryView {
  userId   String
  storyId  String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId])
  @@map("story_views")
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  friend    User             @relation("FriendOf", fields: [friendId], references: [id], map: "Friendship_friendId_fkey")
  user      User             @relation("FriendRequests", fields: [userId], references: [id], map: "Friendship_userId_fkey")

  @@index([friendId], map: "Friendship_friendId_fkey")
  @@index([userId], map: "Friendship_userId_fkey")
  @@map("friendship")
}

model Conversation {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
  calls    Call[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String?      @db.Text
  image          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

enum NotificationType {
  POST_LIKE
  POST_COMMENT
  POST_TAGGED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FOLLOW
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  actorId     String
  postId      String?
  commentId   String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([actorId])
  @@index([recipientId, isRead])
  @@map("notifications")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  REJECTED
  MISSED
  CANCELED
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

model PostTag {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_tags")
}

model Livestream {
  id          String            @id @default(cuid())
  streamerId  String
  title       String            @db.VarChar(255)
  status      LivestreamStatus  @default(LIVE)
  startedAt   DateTime          @default(now())
  endedAt     DateTime?
  viewerCount Int               @default(0)
  streamer    User              @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  messages    LivestreamMessage[]

  @@index([status])
  @@index([streamerId])
  @@map("livestreams")
}

enum LivestreamStatus {
  LIVE
  ENDED
}

model LivestreamMessage {
  id           String     @id @default(cuid())
  livestreamId String
  userId       String
  content      String     @db.Text
  createdAt    DateTime   @default(now())
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([livestreamId, createdAt])
  @@index([userId])
  @@map("livestream_messages")
}

enum ShopVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Shop {
  id              String                @id @default(cuid())
  name            String                @db.VarChar(100)
  slug            String                @unique @db.VarChar(100)
  description     String?               @db.Text
  phone           String?               @db.VarChar(20)
  email           String?               @db.VarChar(255)
  address         String?               @db.Text
  logo            String?
  coverImage      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ownerId         String                @unique
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  verification    ShopVerification?
  products        Product[]
  vouchers        Voucher[]
  promotions      Promotion[]
  orders          Order[]

  @@index([slug])
  @@map("shops")
}

model ShopVerification {
  id         String                  @id @default(cuid())
  shopId     String                  @unique
  shop       Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status     ShopVerificationStatus  @default(PENDING)
  idDocument String?
  notes      String?                 @db.Text
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@map("shop_verifications")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(50)
  slug      String    @unique @db.VarChar(60)
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([slug])
  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model Product {
  id          String          @id @default(cuid())
  shopId      String
  categoryId  String
  name        String          @db.VarChar(200)
  slug        String          @db.VarChar(220)
  description String?         @db.Text
  price       Int
  salePrice   Int?
  sku         String?
  stock       Int             @default(0)
  soldCount   Int             @default(0)
  rating      Float           @default(0)
  reviewCount Int             @default(0)
  isActive    Boolean         @default(true)
  status      ProductStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  promotions  PromotionProduct[]

  @@unique([shopId, slug])
  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(100)
  sku       String?  @db.VarChar(100)
  price     Int
  stock     Int      @default(0)
  image     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  productId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  shopId          String
  status          OrderStatus @default(PENDING)
  subtotal        Int
  discount        Int         @default(0)
  shippingFee     Int         @default(0)
  total           Int
  shippingName    String?     @db.VarChar(100)
  shippingPhone   String?     @db.VarChar(20)
  shippingAddress String?     @db.Text
  note            String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id])
  shop            Shop        @relation(fields: [shopId], references: [id])
  items           OrderItem[]
  voucherUsage    VoucherUsage?

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED
}

model Voucher {
  id              String              @id @default(cuid())
  shopId          String
  code            String              @unique @db.VarChar(50)
  discountType    VoucherDiscountType
  discountValue   Int
  minOrderValue   Int                 @default(0)
  maxDiscount     Int?
  quantity        Int                 @default(100)
  usedCount       Int                 @default(0)
  perUserLimit    Int                 @default(1)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  usages          VoucherUsage[]

  @@index([shopId])
  @@index([code])
  @@map("vouchers")
}

model VoucherUsage {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  orderId   String   @unique
  discount  Int
  createdAt DateTime @default(now())
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@index([voucherId])
  @@index([userId])
  @@map("voucher_usages")
}

enum PromotionType {
  FLASH_SALE
  PRODUCT_DISCOUNT
}

model Promotion {
  id          String           @id @default(cuid())
  shopId      String
  title       String           @db.VarChar(200)
  type        PromotionType
  discount    Int              @db.TinyInt
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    PromotionProduct[]

  @@index([shopId])
  @@index([type, isActive, endDate])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model Call {
  id String @id @default(cuid())

  conversationId String
  callerId       String
  receiverId     String

  type   CallType
  status CallStatus

  startedAt  DateTime?
  answeredAt DateTime?
  endedAt    DateTime?

  duration Int?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallerCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceiverCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([callerId])
  @@index([receiverId])
}
